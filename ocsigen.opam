# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "9.0.0"
synopsis: "Ocsigen tutorial, and the Ocsigen stack it uses"
description: """
Ocsigen is a framework for client/server Web and mobile applications in OCaml.
This package carries the Ocsigen tutorial as its documentation, and installs the main libraries the tutorial uses: Eliom, Ocsigen Server, Ocsigen Start, Ocsigen Toolkit, and Ocsipersist with its SQLite backend.
Ocsigen Start needs PostgreSQL.
"""
maintainer: ["dev@ocsigen.org"]
authors: ["dev@ocsigen.org"]
license: "MIT"
homepage: "https://ocsigen.org/"
doc: "https://ocsigen.org/tuto/latest/"
bug-reports: "https://github.com/ocsigen/tuto/issues"
depends: [
  "dune" {>= "3.18"}
  "eliom" {>= "13.0.0" & < "14.0"}
  "ocsigenserver" {>= "8.0.0" & < "9.0"}
  "ocsigen-start" {>= "9.0.0" & < "10.0"}
  "ocsigen-toolkit" {>= "5.0.0" & < "6.0"}
  "ocsipersist-sqlite-config" {>= "3.1" & < "4.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ocsigen/tuto.git"
x-maintenance-intent: ["(latest)"]
